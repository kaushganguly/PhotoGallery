@model IReadOnlyList<GalleryImage>
@{
    ViewData["Title"] = "Photo Gallery";
}

<section class="jumbotron">
    <h1>Azure Blob Storage Photo Gallery</h1>
    <p>Upload, view, and delete images stored in Azure Blob Storage.</p>
</section>

<form asp-action="UploadAsync" method="post" enctype="multipart/form-data">
    <div class="fileUpload btn btn-default">
        <span>Select Files</span>
        <input type="file" id="file" name="selectFiles" class="upload" onchange="displayFilesToUpload()" multiple />
    </div>
    <p id="FilesToUpload"></p>
    <button id="uploadButton" class="btn btn-primary" type="submit" hidden>Upload</button>
</form>

@if (Model.Count > 0)
{
    <div class="gallery">
        @foreach (var image in Model)
        {
            <div class="imageBlock">
                <a href="@image.Uri" target="_blank" rel="noopener noreferrer">
                    <img class="thumb" src="@image.Uri" alt="Gallery image" />
                </a>
                <form asp-action="DeleteImage" method="post" class="deleteForm">
                    <input type="hidden" name="blobName" value="@image.Name" />
                    <button class="deleteButton" type="submit" aria-label="Delete image">
                        <img class="deleteIcon" src="~/Images/deleteImage.png" alt="" />
                    </button>
                </form>
            </div>
        }
    </div>

    <form asp-action="DeleteAll" method="post">
        <button class="btn btn-default" type="submit">Delete All Files</button>
    </form>
}

<script>
    function displayFilesToUpload() {
        const input = document.getElementById("file");
        const fileList = document.getElementById("FilesToUpload");
        const uploadButton = document.getElementById("uploadButton");
        fileList.replaceChildren();

        if (input.files.length === 0) {
            uploadButton.hidden = true;
            return;
        }

        const heading = document.createElement("h3");
        heading.textContent = "Image(s) to Upload";
        fileList.appendChild(heading);

        for (const [index, file] of Array.from(input.files).entries()) {
            const item = document.createElement("p");
            item.textContent = `${index + 1}. ${file.name} (${file.size} bytes)`;
            fileList.appendChild(item);
        }

        uploadButton.hidden = false;
    }
</script>
