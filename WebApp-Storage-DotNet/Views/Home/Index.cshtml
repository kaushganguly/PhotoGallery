@model IReadOnlyCollection<Uri>
@{
    ViewData["Title"] = "Index";
}

<div class="jumbotron mt-4 p-4 bg-light rounded-3">
    <h2>Azure Blob Storage Photo Gallery</h2>
    <h5>
        Azure Blob storage is a service for storing large amounts of unstructured data, such as text or binary data,
        that can be accessed from anywhere in the world via HTTP or HTTPS.
    </h5>
</div>

<form method="post" action="@Url.Action("UploadAsync", "Home")" enctype="multipart/form-data" class="mb-3">
    <label for="file" class="form-label">Select Files</label>
    <input type="file" id="file" name="selectFiles" class="form-control" multiple />
    <button type="submit" class="btn btn-primary mt-2">Upload</button>
</form>

@if (Model is { Count: > 0 })
{
    <div class="image-grid">
        @foreach (var item in Model)
        {
            <div class="image-block">
                <a href="@item" target="_blank" rel="noopener noreferrer"><img class="thumb" src="@item" alt="Photo @System.IO.Path.GetFileName(item.LocalPath)" /></a>
                <form method="post" action="@Url.Action("DeleteImage", "Home")" class="mt-2">
                    <input type="hidden" name="name" value="@item" />
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </div>
        }
    </div>

    <form method="post" action="@Url.Action("DeleteAll", "Home")" class="mt-3">
        <button type="submit" class="btn btn-danger">Delete All Files</button>
    </form>
}
